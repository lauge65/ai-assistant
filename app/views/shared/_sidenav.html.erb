
<% if user_signed_in? %>
<div class="sidebar-box">
  <div class="nav-item">
    <%= link_to contexts_path, class: "nav-link sidebar-link #{'active' if current_page?(contexts_path)}" do %>
      <i class="fa-regular fa-folder"></i>
      <span>Mes cours</span>
    <% end %>
  </div>

  <% last_context = current_user.contexts.order(updated_at: :desc).first %>

  <div class="nav-item">
    <% if last_context.present? %>
      <%= link_to context_path(last_context), class: "nav-link sidebar-link #{'active' if current_page?(context_path(last_context))}" do %>
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>Reprendre</span>
      <% end %>
    <% else %>
      <div class="nav-link sidebar-link disabled">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>Reprendre</span>
      </div>
    <% end %>
  </div>

  <div class="nav-item">
    <%= link_to new_context_path, class: "nav-link sidebar-link #{'active' if current_page?(new_context_path)}" do %>
      <i class="fa-solid fa-plus"></i>
      <span>Ajouter un cours</span>
    <% end %>
  </div>


  <div class="sidebar-profile">
    <div class="nav-item">
      <%= link_to edit_user_registration_path, class: "nav-link sidebar-link #{'active' if current_page?(edit_user_registration_path)}" do %>
        <i class="fa-regular fa-gear"></i>
        <span>Mon compte</span>
      <% end %>
    </div>

    <%= link_to edit_user_registration_path, class: "nav-link sidebar-link" do %>
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar, class: "avatar", alt: "Photo de profil" %>
      <% else %>
        <span class="avatar avatar-placeholder"><%= current_user.avatar_initial %></span>
      <% end %>
      <span>Se déconnecter</span>
    <% end %>
  </div>
</div>
<% end %>
