
<% if user_signed_in? %>
<div class="sidebar-box">
  <div class="nav-item">
    <%= link_to contexts_path, class: "nav-link sidebar-link #{'active' if current_page?(contexts_path)}" do %>
      <i class="fa-regular fa-folder"></i>
      <span>Mes cours</span>
    <% end %>
  </div>

  <% last_context = current_user.contexts.order(updated_at: :desc).first %>

  <div class="nav-item">
    <% if last_context.present? %>
      <%= link_to context_path(last_context), class: "nav-link sidebar-link #{'active' if current_page?(context_path(last_context))}" do %>
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>Reprendre</span>
      <% end %>
    <% else %>
      <div class="nav-link sidebar-link disabled">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>Reprendre</span>
      </div>
    <% end %>
  </div>

  <div class="nav-item">
    <%= link_to new_context_path, class: "nav-link sidebar-link #{'active' if current_page?(new_context_path)}" do %>
      <i class="fa-solid fa-plus"></i>
      <span>Ajouter un cours</span>
    <% end %>
  </div>


  <div class="sidebar-profile">
    <div class="nav-item">
      <%= link_to edit_user_registration_path, class: "nav-link sidebar-link #{'active' if current_page?(edit_user_registration_path)}" do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M20 21C20 17.6863 16.4183 15 12 15C7.58172 15 4 17.6863 4 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Mon compte</span>
      <% end %>
    </div>

    <%= button_to destroy_user_session_path,
        method: :delete,
        form: { data: { turbo_confirm: "Tu vas être déconnecté. Continuer ?" } },
        class: "nav-link sidebar-link sidebar-logout-btn" do %>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M14 8V6.5C14 5.67157 13.3284 5 12.5 5H7.5C6.67157 5 6 5.67157 6 6.5V17.5C6 18.3284 6.67157 19 7.5 19H12.5C13.3284 19 14 18.3284 14 17.5V16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M16 9L19 12L16 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Déconnexion</span>
    <% end %>
  </div>
</div>
<% end %>
