<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "LOGO BLEU.png", alt: "EasyLearn logo", class: "navbar-logo" %>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item active">
            <%= link_to "Mes cours", "/contexts", class: "nav-link" %>
          </li>

        <% last_context = current_user.contexts.order(created_at: :desc).first %>
        <% last_chat = last_context&.chats&.last %>

        <li class="nav-item">
          <% if last_chat %>
            <%= link_to "Reprendre ma révision", chat_path(last_chat), class: "nav-link" %>
          <% else %>
            <%= link_to "Reprendre ma révision", contexts_path, class: "nav-link text-muted" %>
          <% end %>
        </li>

          <li class="nav-item dropdown">
          <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar, class: "avatar", alt: "Photo de profil" %>
            <% else %>
              <span class="avatar avatar-placeholder"><%= current_user.avatar_initial %></span>
            <% end %>
          </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to "Mon compte", edit_user_registration_path, class: "dropdown-item" %>
              <%= link_to "Se déconnecter", destroy_user_session_path, data: {turbo_method: :delete}, class: "dropdown-item" %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Connexion", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
