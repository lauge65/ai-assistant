<%= turbo_stream_from "chat_#{@chat.id}" %>

<div class="contexts-page py-5">
  <div class="container">
    <div class="mb-4">
      <%= link_to "← Retour à mes cours", contexts_path, class: "text-decoration-none" %>
    </div>

    <div class="context-card mb-4">
      <div class="context-card-body">
        <h1 class="context-card-title mb-2"><%= @context.title %></h1>
        <p class="context-badge mb-4"><%= @context.subject %></p>

        <div class="context-info-list">
          <div class="context-info-item">
            <span class="context-info-label">Niveau</span>
            <span class="context-info-value"><%= @context.level %></span>
          </div>

          <div class="context-info-item">
            <span class="context-info-label">Date</span>
            <span class="context-info-value"><%= @context.date %></span>
          </div>
        </div>
      </div>
    </div>

    <% if @chat.messages.any? && @share_url.present? %>
      <div class="context-card chat-share-card mb-4" data-controller="clipboard">
        <div class="context-card-body">
          <div class="chat-share-card__header">
            <div>
              <h2 class="context-card-title mb-2">Partager ce chat</h2>
              <p class="chat-card__subtitle mb-0">Génère un lien de partage ou scanne le QR code pour ouvrir cette discussion en lecture seule.</p>
            </div>
            <div class="chat-share-card__badge">Lecture seule</div>
          </div>

          <div class="chat-share-card__content">
            <div class="chat-share-card__link-block">
              <label class="chat-share-card__label" for="share-url">URL de partage</label>
              <div class="chat-share-card__link-row">
                <input
                  id="share-url"
                  type="text"
                  class="chat-share-card__input"
                  value="<%= @share_url %>"
                  readonly
                  data-clipboard-target="source">
                <button
                  type="button"
                  class="chat-share-card__copy-btn"
                  data-action="clipboard#copy"
                  data-clipboard-target="button">
                  Copier le lien
                </button>
              </div>
            </div>

            <div class="chat-share-card__qr">
              <%= image_tag "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=#{ERB::Util.url_encode(@share_url)}",
                  alt: "QR code de partage du chat",
                  class: "chat-share-card__qr-image" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="context-card chat-card mb-4">
      <div class="context-card-body">
        <div class="chat-card__header mb-4">
          <div>
            <h2 class="context-card-title mb-2">Discussion avec mon assistant IA</h2>
            <p class="chat-card__subtitle mb-0">Pose ta question et reçois une explication claire, rapide et adaptée a ton niveau.</p>
          </div>

          <%= button_to chat_path(@chat),
              method: :delete,
              form: { data: { turbo_confirm: "Supprimer cet assistant et toute sa discussion ?" }, class: "d-inline" },
              class: "icon-btn danger chat-card__delete border-0",
              aria: { label: "Supprimer cet assistant" } do %>
            <i class="fa-solid fa-trash"></i>
          <% end %>
        </div>
          <div id="messages" class="chat-thread" data-controller="autoscroll">
            <% if @chat.messages.any? %>
              <%= render @chat.messages %>
            <% else %>
              <div class="chat-empty-state">
                <p class="chat-empty-state__title mb-2"></p>
                <p class="chat-empty-state__text mb-0">Commence la conversation ci-dessous </p>
              </div>
            <% end %>
          </div>
      </div>
    </div>

      <div id="new_message">
      <div class="context-card chat-composer-card">
        <div class="context-card-body">
          <%= render "messages/form", chat: @chat, message: @message %>
        </div>
      </div>
    </div>

  </div>
</div>
