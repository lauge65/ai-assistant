<div class="home-layout">
  <div class="home-content">
    <div class="home-banner">
      <div class="container">
        <div class="d-flex justify-content-between align-items-start">
          <div class="home-banner-copy">
            <% if user_signed_in? %>
              <h1 class="mb-3">
                Salut <br>
                <%= current_user.display_first_name %> !
              </h1>
              <p class="mb-4">Importe ton cours, crée ton assistant, révise plus efficacement.</p>
            <% else %>
              <h1 class="mb-3">Transforme ton cours en assistant de révision</h1>
              <p class="mb-4">Importe ton cours, crée ton assistant, révise plus efficacement.</p>
            <% end %>

            <% if user_signed_in? %>
              <%= link_to new_context_path, class: "home-cta text-decoration-none" do %>
                <span class="home-cta-label">Créer mon assistant de révision</span>

              <% end %>
            <% else %>
              <%= link_to new_user_session_path, class: "home-cta text-decoration-none" do %>
                <span class="home-cta-label">Créer mon assistant de révision en quelques secondes</span>

              <% end %>
            <% end %>
          </div>

          <aside class="home-sidebar d-none ms-auto" data-toggle-target="hideable">
            <%= render "shared/sidenav", contexts: @contexts %>
          </aside>
        </div>
      </div>
    </div>


<div class="container my-5">
  <div class="row text-center">

    <div class="col-md-4">
      <div class="context-card h-100 p-4">
        <p class="mb-2">📄</p>
        <h5>Importe ton cours</h5>
        <p>Ajoute ton cours pour créer des outils de révision adaptés.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="context-card h-100 p-4">
        <p class="mb-2">🤖</p>
        <h5>Utilise ton assistant de révision</h5>
        <p>Discute avec ton assistant IA, crée des fiches, écoute un podcast et teste-toi avec des quiz.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="context-card h-100 p-4">
        <p class="mb-2">🎓</p>
        <h5>Progresse à ton rythme</h5>
        <p>Utilise les différents outils pour mieux comprendre et mémoriser</p>
      </div>
    </div>

  </div>
</div>
