<div class="home-page py-5">
  <div class="container">
    <div class="main-frame rounded-5 shadow-sm p-4 p-md-5">

      <!-- Header -->
      <div class="row align-items-center mb-5">
        <div class="col-3"></div>

        <div class="col-6 text-center">
          <h1 class="app-title fw-bold mb-0">EasyLearn</h1>
        </div>

        <div class="col-3 text-end">
          <%= link_to "Login", "#", class: "btn login-btn px-4 py-2 rounded-pill fw-semibold" %>
        </div>
      </div>

      <% if @subjects.present? %>
        <div class="row justify-content-center align-items-stretch g-4 mt-3">

          <% @subjects.each do |subject| %>
            <div class="col-md-4 d-flex justify-content-center">
              <div class="subject-wrapper text-center">
                <div class="subject-title-box rounded-pill py-3 px-4 mb-4">
                  <h2 class="h4 mb-0 fw-semibold"><%= subject.name %></h2>
                </div>

                <div class="subject-card rounded-5 p-4 d-flex flex-column justify-content-between">
                  <div>
                    <% if subject.contexts.any? %>
                      <% subject.contexts.each do |context| %>
                        <p class="context-item"><%= context.name %></p>
                      <% end %>
                    <% else %>
                      <p class="text-muted mt-4">No contexts yet</p>
                    <% end %>
                  </div>

                  <div class="mt-4 d-flex justify-content-center">
                    <%= link_to "Add context", new_subject_context_path(subject), class: "btn qrc-btn rounded-pill px-4" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="col-md-4 d-flex justify-content-center align-items-center">
            <%= link_to new_subject_path,
              class: "create-context-btn text-decoration-none d-flex align-items-center justify-content-center text-center fw-semibold" do %>
              Create<br>
              a new<br>
              subject
            <% end %>
          </div>

        </div>
      <% else %>
        <div class="empty-state d-flex flex-column justify-content-center align-items-center text-center">
          <p class="empty-text mb-4">No subjects yet</p>

          <%= link_to new_subject_path,
            class: "create-context-btn text-decoration-none d-flex align-items-center justify-content-center text-center fw-semibold" do %>
            Create<br>
            a new<br>
            subject
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
