<nav class="navbar navbar-expand-lg custom-navbar px-4 px-md-5 py-3">
  <div class="container-fluid">
    <%= link_to "EasyLearn", root_path, class: "navbar-brand fw-bold fs-3 text-dark" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-4">
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link fw-semibold text-dark" %>
        </li>
        <li class="nav-item">
          <%= link_to "Contexts", contexts_path, class: "nav-link fw-semibold text-dark" %>
        </li>
        <li class="nav-item">
          <%= link_to "New context", new_context_path, class: "nav-link fw-semibold text-dark" %>
        </li>
      </ul>

      <div class="d-flex">
        <%= link_to "Login", "#", class: "btn login-btn px-4 py-2 rounded-pill fw-semibold" %>
      </div>
    </div>
  </div>
</nav>

<div class="home-page py-5">
  <div class="container">
    <div class="main-frame rounded-5 shadow-sm p-4 p-md-5">

      <div class="row align-items-center mb-5">
        <div class="col-12 text-center">
          <h1 class="app-title mb-0">EasyLearn</h1>
        </div>
      </div>

      <% if user_signed_in? && @contexts.present? %>
        <div class="row justify-content-center align-items-stretch g-4 mt-3">

          <% @contexts.each do |context| %>
            <div class="col-md-4 d-flex justify-content-center">
              <div class="subject-wrapper text-center">
                <div class="subject-title-box rounded-pill py-3 px-4 mb-4">
                  <h2 class="h4 mb-0 fw-semibold"><%= context.title %></h2>
                </div>

                <div class="subject-card rounded-5 p-4 d-flex flex-column justify-content-between">
                  <div>
                    <p class="context-item"><strong>Subject:</strong> <%= context.subject %></p>
                    <p class="context-item"><strong>Level:</strong> <%= context.level %></p>
                    <p class="context-item"><strong>Date:</strong> <%= context.date %></p>
                  </div>

                  <div class="mt-4 d-flex justify-content-center">
                    <%= link_to "See all contexts", contexts_path, class: "btn qrc-btn rounded-pill px-4" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="col-md-4 d-flex justify-content-center align-items-center">
            <%= link_to new_context_path,
              class: "create-context-btn text-decoration-none d-flex align-items-center justify-content-center text-center fw-semibold" do %>
              Create<br>
              a new<br>
              context
            <% end %>
          </div>

        </div>
      <% else %>
        <div class="empty-state d-flex flex-column justify-content-center align-items-center text-center">
          <p class="empty-text mb-4">No contexts yet</p>

          <%= link_to new_context_path,
            class: "create-context-btn text-decoration-none d-flex align-items-center justify-content-center text-center fw-semibold" do %>
            Create<br>
            a new<br>
            context
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
