<div class="home-layout">
  <div class="home-content">
    <div class="home-banner">
      <div class="container">
        <div class="d-flex justify-content-between align-items-start">
          <div class="home-banner-copy">
            <% if user_signed_in? %>
              <h1 class="mb-3">
                Salut <br>
                <%= current_user.display_first_name %> !
              </h1>
              <p class="mb-4">Importez votre cours, posez vos questions, révisez plus efficacement.</p>
            <% else %>
              <h1 class="mb-3">Révisez vos cours avec un assistant IA !</h1>
              <p class="mb-4">Importez votre cours, posez vos questions, révisez plus efficacement.</p>
            <% end %>

            <% if user_signed_in? %>
              <%= link_to new_context_path, class: "home-cta text-decoration-none" do %>
                <span class="home-cta-label">Créer mon assistant de révision</span>

              <% end %>
            <% else %>
              <%= link_to new_user_session_path, class: "home-cta text-decoration-none" do %>
                <span class="home-cta-label">Créer mon assistant de révision en quelques secondes</span>

              <% end %>
            <% end %>
          </div>

          <aside class="home-sidebar d-none ms-auto" data-toggle-target="hideable">
            <%= render "shared/sidenav", contexts: @contexts %>
          </aside>
        </div>
      </div>
    </div>


<div class="container my-5">
  <div class="row text-center">

    <div class="col-md-4">
      <div class="context-card h-100 p-4">
        <p class="mb-2">📄</p>
        <h5>Importez votre cours</h5>
        <p>Ajoutez votre document pour créer un assistant adapté à votre leçon.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="context-card h-100 p-4">
        <p class="mb-2">🤖</p>
        <h5>Posez vos questions</h5>
        <p>L’assistant vous aide à comprendre les notions importantes.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="context-card h-100 p-4">
        <p class="mb-2">🎓</p>
        <h5>Progressez à votre rythme</h5>
        <p>Révisez librement et revenez sur les points difficiles.</p>
      </div>
    </div>

  </div>
</div>
