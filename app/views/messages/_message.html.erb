<div id="<%= dom_id(message) %>" class="chat-message chat-message--<%= message.role %>">
  <div class="chat-bubble">
    <strong class="chat-bubble__author">
      <%= message.role == "user" ? "Vous" : "EasyLearn AI" %>
    </strong>
    <div class="chat-bubble__content"><%= simple_format(message.content) %></div>
  </div>
</div>
