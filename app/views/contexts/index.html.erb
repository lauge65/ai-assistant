<div class="contexts-page py-5">
  <div class="container">
    <div class="contexts-header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
      <div>
        <p class="contexts-subtitle mb-2">Dashboard</p>
        <h1 class="contexts-title mb-0">Mes cours importés</h1>
      </div>

      <div class="mt-4 mt-md-0 dashboard-cta-wrap">
        <%= link_to new_context_path, class: "home-cta text-decoration-none" do %>
          <span class="home-cta-label">Importer un nouveau cours</span>
          <span class="home-cta-note">Ajoute un nouveau cours et crée son assistant IA</span>
        <% end %>
      </div>
    </div>

    <% if @contexts.any? %>
      <div class="row g-4">
        <% @contexts.each do |context| %>
          <div class="col-md-6 col-xl-4">
            <div class="context-card h-100 <%= subject_theme(context.subject) %>">
              <div class="context-card-body d-flex flex-column h-100">
                <div class="d-flex justify-content-between align-items-start mb-4">
                  <div>
                    <p class="context-badge mb-2"><%= context.subject %></p>
                    <h2 class="context-card-title mb-0"><%= context.title %></h2>
                  </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mb-3">
                  <%= link_to edit_context_path(context), class: "icon-btn", aria: { label: "Modifier le cours" } do %>
                    <i class="fa-solid fa-pen"></i>
                  <% end %>

                  <%= link_to context_path(context),
                      data: { turbo_method: :delete, turbo_confirm: "Supprimer ce cours et l'assistant associé ?" },
                      class: "icon-btn danger",
                      aria: { label: "Supprimer le cours" } do %>
                    <i class="fa-solid fa-xmark"></i>
                  <% end %>
                </div>

                <div class="context-info-list">
                  <div class="context-info-item">
                    <span class="context-info-label">Niveau</span>
                    <span class="context-info-value"><%= context.level %></span>
                  </div>

                  <div class="context-info-item">
                    <span class="context-info-label">Date</span>
                    <span class="context-info-value"><%= context.date %></span>
                  </div>
                </div>

                <% assistant_chats = context.chats.order(:created_at) %>

                <div class="mt-4 d-flex justify-content-between align-items-start gap-3">
                  <%= link_to context_path(context), class: "document-btn text-decoration-none" do %>
                    <i class="fa-regular fa-file-lines"></i>
                    <span>Mon cours</span>
                  <% end %>

                  <% if assistant_chats.any? %>
                    <div class="assistant-links">
                      <% assistant_chats.each_with_index do |chat, index| %>
                        <div class="assistant-link-row">
                          <%= link_to chat_path(chat), class: "document-btn text-decoration-none document-btn--accent assistant-link-row__main" do %>
                            <i class="fa-solid fa-sparkles"></i>
                            <span>Assistant #<%= index + 1 %></span>
                          <% end %>

                          <%= button_to chat_path(chat),
                              method: :delete,
                              form: { data: { turbo_confirm: "Supprimer cet assistant et toute sa discussion ?" }, class: "d-inline" },
                              class: "icon-btn danger border-0",
                              aria: { label: "Supprimer l'assistant ##{index + 1}" } do %>
                            <i class="fa-solid fa-trash"></i>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="document-btn text-decoration-none opacity-50">
                      <i class="fa-solid fa-sparkles"></i>
                      <span>Assistant indisponible</span>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-context-state text-center">
        <div class="empty-context-box mx-auto">
          <p class="empty-context-emoji mb-3">📚</p>
          <h2 class="empty-context-title mb-2">Pas encore de cours importé</h2>
          <p class="empty-context-text mb-4">
            Commence en important ton premier cours.
          </p>

          <div class="empty-dashboard-cta">
            <%= link_to new_context_path, class: "home-cta text-decoration-none" do %>
              <span class="home-cta-label">Importer un nouveau cours</span>
              <span class="home-cta-note">Ajoute ton premier cours dans EasyLearn</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
