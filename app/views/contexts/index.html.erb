<div class="contexts-page py-5">
  <div class="container-fluid px-3">
    <div class="row g-4 align-items-start">
      <div class="col-md-3 col-lg-2">
        <div class="sidebar-sticky">
          <%= render "shared/sidenav" %>
        </div>
      </div>

      <div class="col-md-9 col-lg-10">


    <div class="contexts-search-bar mb-5">
      <%= form_with url: contexts_path, method: :get, local: true, class: "search-form" do %>
        <div class="search-input-group">
          <%= text_field_tag :query,
            params[:query],
            placeholder: "Rechercher un cours...",
            class: "search-input" %>

          <%= submit_tag "Rechercher", class: "search-btn" %>
        </div>
      <% end %>
    </div>

    <div class="contexts-header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
      <div>
        <p class="contexts-subtitle mb-2">Dashboard</p>
        <h1 class="contexts-title mb-0">Mes cours importés</h1>
      </div>

      <div class="mt-4 mt-md-0 dashboard-cta-wrap">
        <%= link_to new_context_path, class: "home-cta text-decoration-none" do %>
          <span class="home-cta-label">Ajouter un cours</span>
          <span class="home-cta-note">Crée ton assistant de révision</span>
        <% end %>
      </div>
    </div>

    <% if @contexts.any? %>
      <div class="row g-4">
        <% @contexts.each do |context| %>
          <div class="col-md-6 col-xl-4">
            <div class="context-card context-card--clickable h-100 position-relative <%= subject_theme(context.subject) %>">
              <%= link_to "", context_path(context), class: "stretched-link context-card-link", aria: { label: "Ouvrir #{context.title}" } %>

              <div class="context-card-body d-flex flex-column h-100">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                  <div class="context-card-header-meta">
                    <p class="context-badge mb-2"><%= context.subject %></p>
                    <div class="context-meta-chips">
                      <span class="context-meta-chip"><%= context.level %></span>
                      <span class="context-meta-chip"><%= l(context.date, format: :long) %></span>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end gap-3 context-card-actions position-relative" style="z-index: 2;">
                    <%= link_to edit_context_path(context), class: "icon-btn" do %>
                    <i class="fa-solid fa-pen"></i>
                    <% end %>

                    <%= button_to context_path(context),
                        method: :delete,
                        form: { data: { turbo_confirm: "Supprimer ce cours et l'assistant associé ?" }, class: "d-inline" },
                        class: "icon-btn danger" do %>
                      <i class="fa-solid fa-trash"></i>
                    <% end %>
                  </div>
                </div>

                <div class="text-center mt-2 mb-3">
                  <h2 class="context-card-title mb-2"><%= context.title %></h2>

                </div>

                <div class="context-card-progress mt-3">
                  <%= render "progress_ring", context: context %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-context-state text-center">
        <div class="empty-context-box mx-auto">
          <% if params[:query].present? %>
            <p class="empty-context-emoji mb-3">🔍</p>
            <h2 class="empty-context-title mb-2">Aucun cours trouvé</h2>
            <p class="empty-context-text mb-4">
              Aucun cours ne correspond à "<%= params[:query] %>".
            </p>
            <%= link_to "Voir tous mes cours", contexts_path, class: "btn btn-outline-primary" %>
          <% else %>
            <p class="empty-context-emoji mb-3">📚</p>
            <h2 class="empty-context-title mb-2">Pas encore de cours importé</h2>
            <p class="empty-context-text mb-4">
              Commence en important ton premier cours.
            </p>

            <div class="empty-dashboard-cta">
              <%= link_to new_context_path, class: "home-cta text-decoration-none" do %>
                <span class="home-cta-label">Importer un nouveau cours</span>
                <span class="home-cta-note">Ajoute ton premier cours dans EasyLearn</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

      </div>
    </div>
  </div>
</div>
