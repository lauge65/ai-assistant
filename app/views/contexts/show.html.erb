<div class="container my-5">
  <%= link_to "← Retour à mes cours", contexts_path, class: "text-decoration-none" %>

  <div class="context-card mt-4">
    <div class="context-card-body">

      <div class="d-flex justify-content-between align-items-start flex-wrap gap-4">

        <div style="max-width: 700px">
          <h1 class="context-card-title"><%= @context.title %></h1>

          <p class="context-badge mb-4"><%= @context.subject %></p>

          <div class="context-info-list">
            <div class="context-info-item">
              <span class="context-info-label">Niveau</span>
              <span class="context-info-value"><%= @context.level %></span>
            </div>

            <div class="context-info-item">
              <span class="context-info-label">Date</span>
              <span class="context-info-value"><%= @context.date %></span>
            </div>
          </div>

          <div class="mt-4">
            <% if @context.document.attached? %>
              <%= link_to "⬇️ Télécharger mon cours",
                  rails_blob_path(@context.document, disposition: "attachment"),
                  class: "document-btn text-decoration-none" %>

              <%= link_to "📄 Ouvrir mon cours",
                  url_for(@context.document),
                  target: "_blank",
                  class: "document-btn text-decoration-none" %>
            <% else %>
              <p>Pas de cours téléchargé.</p>
            <% end %>
          </div>
          </div>
        <div class="d-flex align-items-center">
  <div class="mt-4 d-flex flex-column gap-3">
    <%= button_to "🤖 Créer un nouvel assistant IA sur le même cours",
      context_chats_path(@context),
      method: :post,
      class: "new-context-btn border-0 text-decoration-none d-inline-flex align-items-center justify-content-center" %>

    <% if @context.document.attached? %>
      <% if @context.podcast_script&.audio&.attached? %>
        <%# Podcast prêt : afficher le bouton de téléchargement %>
        <%= link_to download_audio_context_podcast_script_path(@context),
                    class: "podcast-btn text-decoration-none d-inline-flex align-items-center justify-content-center",
                    data: { turbo: false } do %>
          🎧 Télécharger le podcast
        <% end %>
      <% elsif @context.podcast_script&.generating? || @context.podcast_script&.audio_status == "generating" %>
        <%# Génération en cours : afficher un message d'attente %>
        <div class="podcast-btn text-decoration-none d-inline-flex align-items-center justify-content-center" style="opacity: 0.7; cursor: wait;">
          ⏳ Génération en cours...
        </div>
        <small class="text-muted mt-1">Rafraîchissez la page dans 1-2 minutes</small>
      <% elsif @context.podcast_script&.failed? || @context.podcast_script&.audio_status == "failed" %>
        <%# Génération échouée : permettre de réessayer %>
        <%= button_to "🔄 Réessayer le podcast",
          context_podcast_script_path(@context),
          method: :post,
          class: "podcast-btn border-0 text-decoration-none d-inline-flex align-items-center justify-content-center" %>
        <small class="text-danger mt-1">La génération précédente a échoué</small>
      <% else %>
        <%# Pas encore de podcast : afficher le bouton de génération %>
        <%= button_to "🎙️ Générer le podcast",
          context_podcast_script_path(@context),
          method: :post,
          class: "podcast-btn border-0 text-decoration-none d-inline-flex align-items-center justify-content-center" %>
      <% end %>
    <% end %>
  </div>
</div>
        </div>
    </div>
    </div>
  </div>
</div>
