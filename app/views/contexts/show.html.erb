<div class="contexts-page py-5">
  <div class="container-fluid px-3">
    <div class="row g-4 align-items-start">
      <div class="col-md-3 col-lg-2 sidebar-col">
        <div class="sidebar-sticky">
          <%= render "shared/sidenav" %>
        </div>
      </div>

      <div class="col-md-9 col-lg-10">

  <div
    class="confetti-overlay"
    data-controller="confetti"
    data-confetti-active-value="<%= flash[:confetti].present? %>">
  </div>

  <%= turbo_stream_from "chat_#{@chat.id}" if @chat.present? %>

  <div class="context-show-layout mt-4">

    <!-- COLONNE GAUCHE -->
    <div class="context-show-main-column">
      <div class="context-card">
        <div class="context-card-body">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-4">
            <div class="context-show-main" data-controller="toggle">
              <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
                <div>
                  <p class="context-badge mb-2"><%= @context.subject %></p>
                  <h1 class="context-card-title mb-2"><%= @context.title %></h1>
                  <div class="context-meta-chips">
                    <span class="context-meta-chip"><%= @context.level %></span>
                    <span class="context-meta-chip"><%= l(@context.date, format: :long) %></span>
                  </div>
                </div>

                <div class="progress-ring-trigger" data-action="click->toggle#call">
                  <%= render "progress_ring", context: @context %>
                  <span class="progress-ring-hint">voir le détail</span>
                </div>
              </div>

              <div class="context-actions-row mt-4">
                <% if @context.document.attached? %>
                  <%= link_to "📄 Mon cours",
                      lecture_context_path(@context),
                      class: "document-btn text-decoration-none",
                      data: { turbo_frame: "pdf-viewer" } %>
                <% else %>
                  <span class="document-btn context-action-disabled">📄 Mon cours</span>
                <% end %>

                <% if @context.podcast_script&.audio&.attached? %>
                  <%= link_to download_audio_context_podcast_script_path(@context),
                      class: "document-btn text-decoration-none",
                      data: { turbo: false } do %>
                    ⬇️ Podcast
                  <% end %>
                <% elsif @context.podcast_script&.generating? || @context.podcast_script&.audio_status == "generating" %>
                  <span class="document-btn context-action-disabled">⏳ Podcast</span>
                <% elsif @context.podcast_script&.failed? || @context.podcast_script&.audio_status == "failed" %>
                  <%= button_to "🔄 Podcast",
                      context_podcast_script_path(@context),
                      method: :post,
                      class: "document-btn border-0" %>
                <% else %>
                  <%= button_to "🎙️ Podcast",
                      context_podcast_script_path(@context),
                      method: :post,
                      class: "document-btn border-0" %>
                <% end %>

                <% if @context.summary.attached? %>
                  <%= link_to "📖 Fiche de révision",
                      lecture_summary_context_path(@context),
                      class: "document-btn text-decoration-none",
                      data: { turbo_frame: "pdf-viewer" } %>
                <% else %>
                  <%= button_to "📝 Fiche de révision",
                      generate_summary_context_path(@context),
                      method: :post,
                      class: "document-btn border-0" %>
                <% end %>
              </div>

              <% if @context.podcast_script&.audio&.attached? %>
                <div class="podcast-player-wrapper mt-4"
                     data-controller="podcast-player"
                     data-podcast-player-mark-url-value="<%= mark_played_context_podcast_script_path(@context) %>">
                  <audio data-podcast-player-target="audio"
                         src="<%= rails_blob_url(@context.podcast_script.audio, disposition: "inline") %>"
                         preload="none">
                  </audio>
                </div>
              <% end %>

              <turbo-frame id="pdf-viewer" class="pdf-viewer-frame"></turbo-frame>

              <div data-toggle-target="hideable" class="d-none">
              <div class="context-progress-panel mt-4">
                <div class="context-progress-panel__header">
                  <div>
                    <p class="context-progress-panel__eyebrow mb-1">Ma progression</p>
                    <h2 class="context-progress-panel__title mb-0">Les etapes de revision</h2>
                  </div>

                  <span class="context-progress-panel__summary"><%= @context.progress_completed_steps %>/5</span>
                </div>

                <div class="context-progress-steps">
                  <% @context.progress_step_labels.each do |step, label| %>
                    <div class="context-progress-step <%= "is-complete" if @context.public_send(step) %>">
                      <span class="context-progress-step__icon"><%= @context.public_send(step) ? "✓" : "•" %></span>
                      <span class="context-progress-step__label"><%= label %></span>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="mt-4 d-flex flex-column gap-2 align-items-start">
                <% if @context.revision_completed? %>
                  <span class="context-completion-badge">✅ Révision terminée</span>
                <% elsif @context.all_steps_before_revision_done? %>
                  <%= button_to "🎉 Je me sens prêt",
                    complete_revision_context_path(@context),
                    method: :patch,
                    class: "document-btn document-btn--ready border-0 text-decoration-none d-inline-flex align-items-center justify-content-center" %>
                <% else %>
                  <span
                    class="document-btn document-btn--locked d-inline-flex align-items-center justify-content-center"
                    title="Termine toutes les étapes pour débloquer cette action">
                    🔒 Je me sens prêt
                  </span>
                <% end %>
              </div>
              </div><%# fin hideable %>

            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- COLONNE DROITE -->
    <div class="context-show-chat-column">

      <div class="context-card chat-card mb-4">
        <div class="context-card-body">
          <div class="chat-card__header mb-4">
            <div>
              <h2 class="context-card-title mb-2">Discussion avec mon assistant IA</h2>
              <p class="chat-card__subtitle mb-0">
                Pose ta question et reçois une explication claire, rapide et adaptée à ton niveau.
              </p>
            </div>
          </div>

          <div id="messages" class="chat-thread" data-controller="autoscroll">
            <% if @chat.present? && @chat.messages.any? %>
              <%= render @chat.messages %>
            <% else %>
              <div class="chat-empty-state">
                <p class="chat-empty-state__text mb-0">Commence la conversation ci-dessous</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div id="new_message">
        <div class="context-card chat-composer-card">
          <div class="context-card-body">
            <% if @chat.present? %>
              <%= render "messages/form", chat: @chat, message: @message %>
            <% end %>
          </div>
        </div>
      </div>

      <% if @chat.present? && @share_url.present? %>
        <div class="context-card context-card--compact-qr mt-4">
          <div class="context-card-body">
            <div class="compact-qr__layout">
              <div class="compact-qr__text">
                <h2 class="context-card-title mb-2">Continuer sur mobile</h2>
                <p class="chat-card__subtitle mb-0">
                  Scanne ce QR code pour retrouver cette discussion sur ton téléphone.
                </p>
              </div>
              <%= image_tag "https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=#{ERB::Util.url_encode(@share_url)}",
                  alt: "QR code du chat",
                  class: "chat-share-qr-image" %>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
</div>
</div>
</div>
