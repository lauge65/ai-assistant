<div>

  <div class="lecture-toolbar">
    <%= link_to "← Retour au cours", context_path(@context), class: "lecture-toolbar__back text-decoration-none" %>
    <span class="lecture-toolbar__title"><%= @context.title %></span>
  </div>

  <embed src="<%= @pdf_url %>" type="application/pdf" class="lecture-embed">

  <div class="lecture-footer container py-4 text-center">
    <p class="lecture-footer__hint text-muted">✅ Cours marqué comme découvert.</p>
    <%= link_to "← Retour au cours", context_path(@context), class: "document-btn text-decoration-none" %>
  </div>
</div>
