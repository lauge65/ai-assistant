<div class="container">
  <div class="row">
    <div class="col-md-4 offset-md-4">
        <h2>Connexion</h2>

        <% if session["user_return_to"]&.start_with?("/shared/chats/") %>
          <p class="text-muted mb-4">Connectez-vous pour ouvrir cette conversation sur votre compte.</p>
        <% end %>

        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="form-inputs">
            <%= f.input :email,
                        required: false,
                        autofocus: true,
                        label: "Email",
                        input_html: { autocomplete: "email" } %>
            <%= f.input :password,
                        required: false,
                        label: "Mot de passe",
                        input_html: { autocomplete: "current-password" } %>
            <%= f.input :remember_me, as: :boolean, label: "Se souvenir de moi" if devise_mapping.rememberable? %>
          </div>

          <div class="form-actions">
            <%= f.button :submit, "Se connecter", class: "btn btn-primary" %>
          </div>
        <% end %>
        <br>
        <%= render "devise/shared/links" %>

    </div>
  </div>
</div>
